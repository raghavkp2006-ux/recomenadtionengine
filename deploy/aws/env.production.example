# ==============================================================================
# Production Environment Variables & Secrets Reference
# Region: ap-south-1
# Store secrets in AWS Secrets Manager or AWS Systems Manager Parameter Store.
# ==============================================================================

# Core Application
ENV=production
PORT=8080
FRONTEND_URL=https://your-frontend-domain.com
ALLOWED_ORIGINS=https://your-frontend-domain.com

# PostgreSQL Database (e.g. AWS RDS PostgreSQL)
# Format: postgresql://<user>:<password>@<rds-endpoint>:5432/<dbname>
DATABASE_URL=postgresql://app_user:strong_password@recommendation-db.xxxxx.ap-south-1.rds.amazonaws.com:5432/polytaste

# Session Security (random 64-char string; required when ENV=production)
SESSION_SECRET_KEY=generate_with_openssl_rand_hex_32

# Google OAuth 2.0 (Redirect URI points to the backend callback on ECS/ALB)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://api.your-domain.com/auth/google/callback

# Spotify OAuth (Redirect URI points to backend callback on ECS/ALB)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=https://api.your-domain.com/spotify/callback

# AniList OAuth (Redirect URI points to backend callback on ECS/ALB)
ANILIST_CLIENT_ID=your-anilist-client-id
ANILIST_CLIENT_SECRET=your-anilist-client-secret
ANILIST_REDIRECT_URI=https://api.your-domain.com/anilist/callback

# External APIs
TMDB_API_KEY=your-tmdb-api-key
YOUTUBE_API_KEY=your-youtube-api-key

# Myntra Integration Configuration
MYNTRA_EVENT_BATCH_SIZE=25
MYNTRA_MAX_BATCH_SIZE=100
MYNTRA_PROFILE_DECAY_LAMBDA=0.03
MYNTRA_DEDUP_WINDOW_SECONDS=30
