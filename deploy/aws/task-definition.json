{
  "family": "recommendation-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::542035162593:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::542035162593:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "recommendation-api",
      "image": "542035162593.dkr.ecr.ap-south-1.amazonaws.com/recommendation-api:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "ENV", "value": "production" },
        { "name": "PORT", "value": "8080" },
        { "name": "FRONTEND_URL", "value": "https://d1l7jo0szjotpa.cloudfront.net" },
        { "name": "ALLOWED_ORIGINS", "value": "https://d1l7jo0szjotpa.cloudfront.net,http://recommendation-alb-364635366.ap-south-1.elb.amazonaws.com,http://localhost:5173,http://127.0.0.1:5173" },
        { "name": "GOOGLE_REDIRECT_URI", "value": "https://d1l7jo0szjotpa.cloudfront.net/auth/google/callback" },
        { "name": "SPOTIFY_REDIRECT_URI", "value": "https://d1l7jo0szjotpa.cloudfront.net/spotify/callback" },
        { "name": "ANILIST_REDIRECT_URI", "value": "https://d1l7jo0szjotpa.cloudfront.net/anilist/callback" },
        { "name": "MYNTRA_EVENT_BATCH_SIZE", "value": "25" },
        { "name": "MYNTRA_MAX_BATCH_SIZE", "value": "100" },
        { "name": "MYNTRA_PROFILE_DECAY_LAMBDA", "value": "0.03" },
        { "name": "MYNTRA_DEDUP_WINDOW_SECONDS", "value": "30" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:ap-south-1:542035162593:secret:recommendation-api/secrets-kaibqu:DATABASE_URL::" },
        { "name": "SESSION_SECRET_KEY", "valueFrom": "arn:aws:secretsmanager:ap-south-1:542035162593:secret:recommendation-api/secrets-kaibqu:SESSION_SECRET_KEY::" },
        { "name": "GOOGLE_CLIENT_ID", "valueFrom": "arn:aws:secretsmanager:ap-south-1:542035162593:secret:recommendation-api/secrets-kaibqu:GOOGLE_CLIENT_ID::" },
        { "name": "GOOGLE_CLIENT_SECRET", "valueFrom": "arn:aws:secretsmanager:ap-south-1:542035162593:secret:recommendation-api/secrets-kaibqu:GOOGLE_CLIENT_SECRET::" },
        { "name": "SPOTIFY_CLIENT_ID", "valueFrom": "arn:aws:secretsmanager:ap-south-1:542035162593:secret:recommendation-api/secrets-kaibqu:SPOTIFY_CLIENT_ID::" },
        { "name": "SPOTIFY_CLIENT_SECRET", "valueFrom": "arn:aws:secretsmanager:ap-south-1:542035162593:secret:recommendation-api/secrets-kaibqu:SPOTIFY_CLIENT_SECRET::" },
        { "name": "ANILIST_CLIENT_ID", "valueFrom": "arn:aws:secretsmanager:ap-south-1:542035162593:secret:recommendation-api/secrets-kaibqu:ANILIST_CLIENT_ID::" },
        { "name": "ANILIST_CLIENT_SECRET", "valueFrom": "arn:aws:secretsmanager:ap-south-1:542035162593:secret:recommendation-api/secrets-kaibqu:ANILIST_CLIENT_SECRET::" },
        { "name": "TMDB_API_KEY", "valueFrom": "arn:aws:secretsmanager:ap-south-1:542035162593:secret:recommendation-api/secrets-kaibqu:TMDB_API_KEY::" },
        { "name": "YOUTUBE_API_KEY", "valueFrom": "arn:aws:secretsmanager:ap-south-1:542035162593:secret:recommendation-api/secrets-kaibqu:YOUTUBE_API_KEY::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/recommendation-api",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:8080/health')\" || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      }
    }
  ]
}
