# Spotify Developer App Credentials
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/spotify/callback

# Google OAuth 2.0 (Sign In With Google — ID-token flow)
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorized redirect URIs must include your frontend origin, e.g. http://localhost:5173
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5173/#id_token=

# Session Secret (for signed cookies)
# Must be set to a secure random string in production!
SESSION_SECRET_KEY=dev_secret_key_change_me_in_prod

# Myntra integration (server-side configuration; no Myntra or browser secrets)
MYNTRA_EVENT_BATCH_SIZE=25
MYNTRA_MAX_BATCH_SIZE=100
MYNTRA_PROFILE_DECAY_LAMBDA=0.03
MYNTRA_DEDUP_WINDOW_SECONDS=30


# YouTube Data API v3 Key (required for GET /anime/{mal_id}/videos)
# Create a project and enable the YouTube Data API v3 at:
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Note: search.list costs 100 quota units; free tier = 10,000 units/day (~100 searches/day).
YOUTUBE_API_KEY=your_youtube_api_key_here
# AWS / DynamoDB (required for production Lambda deployment only)
# Leave unset for local development — the app auto-switches to SQLite.
# DYNAMODB_TABLE_NAME=spotify_users
# S3_BUCKET_NAME=your-bucket-name
# AWS_DEFAULT_REGION=us-east-1

# AniList OAuth 2.0 Credentials
ANILIST_CLIENT_ID=your_anilist_client_id_here
ANILIST_CLIENT_SECRET=your_anilist_client_secret_here
ANILIST_REDIRECT_URI=http://127.0.0.1:8000/anilist/callback

# TMDB API v3 Key (required for movie catalog fetch)
# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
